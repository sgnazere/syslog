# ============================================================
# SYSLOG — Variables d'environnement (développement)
# Copier en ".env". Ne jamais commiter le fichier .env.
# Secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

# ── Base de données PostgreSQL ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eclog
DB_USER=syslog_app
DB_PASSWORD=
# Compte propriétaire des tables, utilisé uniquement par « npm run migrate »
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=

# ── Sécurité (secrets obligatoires, 32 caractères minimum) ──
JWT_SECRET=
JWT_EXPIRES_IN=8h
LICENSE_SECRET=

# ── Serveur ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Adresse(s) exacte(s) de l'application, séparées par des virgules (CORS + anti-CSRF).
# Une adresse absente reçoit « Origine de la requête refusée » (403). Joker possible : https://*.devtunnels.ms
FRONTEND_URL=http://localhost:5173
# Nombre de reverse proxys devant l'API (0 en local, 1 derrière Nginx)
TRUST_PROXY=0

# ── WhatsApp Cloud API (facultatif) ────────────────────────
WA_ENABLED=false
WA_PHONE_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
