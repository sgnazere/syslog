# ============================================================
# SYSLOG — Variables d'environnement PRODUCTION
# Copier en ".env" sur le serveur. Ne jamais commiter ce fichier.
# Le serveur refuse de démarrer si un secret est absent, trop court
# ou égal à une valeur d'exemple.
# Secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

# ── Base de données : rôle dédié, jamais le superutilisateur postgres ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syslog_prod
DB_USER=syslog_app
DB_PASSWORD=                      # 20 caractères minimum recommandés
# Compte propriétaire des tables, utilisé uniquement par « npm run migrate »
DB_MIGRATION_USER=syslog_owner
DB_MIGRATION_PASSWORD=

# ── Sécurité : secrets DIFFÉRENTS de ceux du développement ──
JWT_SECRET=
JWT_EXPIRES_IN=8h
LICENSE_SECRET=                   # changer ce secret invalide les clés de licence existantes

# ── Serveur ────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Adresse(s) exacte(s) de l'application, séparées par des virgules (CORS + anti-CSRF).
# Une adresse absente reçoit « Origine de la requête refusée » (403). Joker possible : https://*.devtunnels.ms
FRONTEND_URL=https://syslog.espaceconfiance.ci
TRUST_PROXY=1
# Pool PostgreSQL (défaut 30). UV_THREADPOOL_SIZE se définit dans la commande PM2 (voir documentation).
DB_POOL_MAX=30

# ── WhatsApp Cloud API (si activé) ─────────────────────────
WA_ENABLED=false
WA_PHONE_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=                    # App Secret Meta : vérifie la signature du webhook
