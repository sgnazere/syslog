# ============================================================
# SYSLOG — Variables d'environnement PRODUCTION
# Copier ce fichier en ".env" sur le serveur de production
# NE JAMAIS COMMITER ce fichier dans git
# ============================================================

# ── Base de données ──────────────────────────────────────────
# Utiliser un utilisateur dédié (pas le superuser postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syslog_prod
DB_USER=syslog_user            # ← utilisateur dédié (voir §2)
DB_PASSWORD=MOT_DE_PASSE_FORT  # ← min 20 caractères, alphanum + spéciaux

# ── JWT ──────────────────────────────────────────────────────
# Générer avec : node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=GENERER_UN_SECRET_64_CHARS_MINIMUM
JWT_EXPIRES_IN=8h

# ── Serveur ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production             # ← OBLIGATOIRE

# ── CORS ─────────────────────────────────────────────────────
# URL exacte du frontend en production (avec https)
FRONTEND_URL=https://syslog.espaceconfiance.ci

# ── Licence ──────────────────────────────────────────────────
# SECRET DIFFÉRENT de la version dev — regénérer la licence après changement
LICENSE_SECRET=GENERER_UN_AUTRE_SECRET_64_CHARS

# ── WhatsApp (si activé) ─────────────────────────────────────
WA_ENABLED=false
WA_PHONE_ID=PHONE_NUMBER_ID_META
WA_TOKEN=ACCESS_TOKEN_PERMANENT_META
WA_VERIFY_TOKEN=TOKEN_WEBHOOK_PERSONNALISE
